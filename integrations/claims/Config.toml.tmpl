# ── Service database and neighbours ───────────────────────────────────────────
[claimflow.claims]
dbHost = "appdb"
dbUser = "app"
dbPassword = "app"
dbName = "claims_db"
notificationsUrl = "http://notifications:8080"

# ── Workflow engine ───────────────────────────────────────────────────────────
[ballerina.workflow]
mode = "SELF_HOSTED"
url = "@TEMPORAL_URL@"
namespace = "default"
taskQueue = "CLAIMS_TASK_QUEUE"

# ── ICP runtime bridge ────────────────────────────────────────────────────────
[wso2.icp.runtime.bridge]
# The edge proxy's runtime listener (9445). The console (9446) would answer 405 on
# /icp/heartbeat — different service, no such resource.
serverUrl = "@ICP_SERVER_URL@"
# The distribution serves a self-signed certificate; this skips verification.
enableSSL = false
heartbeatInterval = @HEARTBEAT_INTERVAL@

secret = "@ICP_ORG_SECRET@"
project = "@ICP_PROJECT@"
integration = "claims"
environment = "@ICP_ENVIRONMENT@"

# Without this the bridge still publishes workflow metadata but refuses tunneled
# commands — and, since management is this integration's only entry point for now, the
# process would also exit as soon as it finished registering.
enableWorkflowManagement = true
