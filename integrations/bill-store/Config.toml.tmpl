# ── Service database and storage ──────────────────────────────────────────────
[claimflow.bill_store]
dbHost = "appdb"
dbUser = "app"
dbPassword = "app"
dbName = "bills_db"
storageDir = "/data/bills"
publicBaseUrl = "@BILLS_PUBLIC_URL@"
claimsUrl = "http://claims:8080"

# ── ICP runtime bridge ────────────────────────────────────────────────────────
[wso2.icp.runtime.bridge]
serverUrl = "@ICP_SERVER_URL@"
enableSSL = false
heartbeatInterval = @HEARTBEAT_INTERVAL@

secret = "@ICP_ORG_SECRET@"
project = "@ICP_PROJECT@"
integration = "bill-store"
environment = "@ICP_ENVIRONMENT@"
enableWorkflowManagement = false

# A plain service: registers and reports artifacts, accepts no workflow commands.

# ── Observability ──────────────────────────────────────────────────────────────
# Metrics go two ways: the Prometheus reporter serves /metrics on :9797 for the demo's Prometheus,
# and ballerinax/metrics.logs publishes each sample as a log line for the console's metrics index.
# Traces go to the demo's Jaeger over OTLP; the workflow module adds a span per client call.
[ballerina.observe]
metricsEnabled = true
metricsReporter = "prometheus"
metricsLogsEnabled = true
tracingEnabled = true
tracingProvider = "jaeger"

[ballerinax.jaeger]
agentHostname = "jaeger"
agentPort = 4317

# ── Logging ───────────────────────────────────────────────────────────────────
# JSON, so every key the code attaches to a log call — who decided a task, what and when —
# reaches OpenSearch as its own field rather than as text inside the message.
[ballerina.log]
format = "json"
