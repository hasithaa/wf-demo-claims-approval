# Build outputs staged by build.sh (regenerated from prebuilt/ every run)
artifacts/
icp/artifacts/
integrations/*/artifacts/
integrations/*/target/
integrations/*/Dependencies.toml
# Extracted from the bridge bala by bal during build — regenerated every build.sh run
prebuilt/compiler-plugin/
prebuilt/platform/
# Local Config.toml files can carry live AI tokens — never committed; the entrypoint
# renders the real one inside the container.
integrations/*/Config.toml
.local/

# The cluster edge's TLS certificate — generated by build_cluster.sh on first use.
# Self-signed and disposable: nothing pins it, and regenerating is harmless.
edge/certs/
