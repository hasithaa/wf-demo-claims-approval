# Demo defaults — safe to commit, meant to be edited. compose reads this file;
# anything here can also be overridden from the shell environment.

# Host ports
CONSOLE_PORT=9664
THUNDER_PORT=8090
TEMPORAL_UI_PORT=8233
PORTAL_PORT=9090
PORTAL_PUBLIC_URL=http://localhost:9090

# ICP
ICP_ADMIN_USER=admin
ICP_ADMIN_PASSWORD=admin
ICP_PROJECT=claimflow
ICP_ENVIRONMENT=dev
# The environment id the schema seeds for `dev`.
ICP_ENVIRONMENT_ID=750e8400-e29b-41d4-a716-446655440001

# Thunder (identity provider) and SSO
THUNDER_ADMIN_USER=admin
THUNDER_ADMIN_PASSWORD=admin12345
THUNDER_DIRECT_AUTH_SECRET=claimflow-direct-secret
SSO_ENABLED=true
# Smart Claim agent model: generate from VS Code (BI "default model provider" token,
# ~1h expiry), then: docker compose up -d claims-agent. Empty = scripted offline model.
WSO2_AI_SERVICE_URL=
WSO2_AI_TOKEN=
# What the BROWSER uses to reach Thunder — must match Thunder's issuer (its public_url).
THUNDER_PUBLIC_URL=https://localhost:8090
ICP_SSO_CLIENT_SECRET=icp-console-secret

# Sizing
ICP_HEAP=512m
INTEGRATION_HEAP=384m
HEARTBEAT_INTERVAL=10
